<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==============================================================================
         mepOS — SWISS CLEAN ARCHITECTURAL WPF THEME
         Standard: AGENTS.md (STANDARD 4) & MyOS tokens.css
         ============================================================================== -->

    <!-- ── Palette Brushes ──────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="WindowBgBrush"       Color="#F6F6F4"/>
    <SolidColorBrush x:Key="CardBgBrush"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleBgBrush"       Color="#EEEEE9"/>
    <SolidColorBrush x:Key="BorderBrush"         Color="#0A0A0A"/>
    <SolidColorBrush x:Key="SubtleBorderBrush"   Color="#D4D4CE"/>
    <SolidColorBrush x:Key="TextBrush"           Color="#0A0A0A"/>
    <SolidColorBrush x:Key="MutedTextBrush"      Color="#777777"/>
    <SolidColorBrush x:Key="DimTextBrush"        Color="#444444"/>
    <SolidColorBrush x:Key="AccentYellowBrush"   Color="#FFDD00"/>
    <SolidColorBrush x:Key="AccentYellowDimBrush" Color="#FFF4A3"/>
    <SolidColorBrush x:Key="StatusGreenBrush"    Color="#059669"/>
    <SolidColorBrush x:Key="StatusRedBrush"      Color="#DC2626"/>

    <!-- ── Hard-Edge Swiss Shadows (Strict Zero-Blur) ────────────────────────── -->
    <DropShadowEffect x:Key="HardShadow3px"
                      Color="#0A0A0A"
                      Direction="315"
                      ShadowDepth="3"
                      BlurRadius="0"
                      Opacity="1.0"/>

    <DropShadowEffect x:Key="HardShadow2px"
                      Color="#0A0A0A"
                      Direction="315"
                      ShadowDepth="2"
                      BlurRadius="0"
                      Opacity="1.0"/>

    <!-- ── Card Style ───────────────────────────────────────────────────────── -->
    <Style x:Key="SwissCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Effect" Value="{StaticResource HardShadow3px}"/>
    </Style>

    <!-- ── Section Title ────────────────────────────────────────────────────── -->
    <Style x:Key="SwissSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- ── Field Label ──────────────────────────────────────────────────────── -->
    <Style x:Key="SwissFieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DimTextBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── Primary Button (Yellow Accent + Hard Shadow) ──────────────────────── -->
    <Style x:Key="SwissPrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Background" Value="{StaticResource AccentYellowBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Shadow Block -->
                        <Border x:Name="Shadow"
                                Background="{StaticResource BorderBrush}"
                                Margin="2,2,-2,-2"
                                CornerRadius="2"/>
                        <!-- Main Button Face -->
                        <Border x:Name="Face"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#FFE833"/>
                            <Setter TargetName="Face" Property="Margin" Value="-1,-1,1,1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="2,2,-2,-2"/>
                            <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Background" Value="#E2E8F0"/>
                            <Setter TargetName="Face" Property="BorderBrush" Value="#94A3B8"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Ghost / Subtle Button ────────────────────────────────────────────── -->
    <Style x:Key="SwissGhostButton" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Shadow"
                                Background="{StaticResource BorderBrush}"
                                Margin="2,2,-2,-2"
                                CornerRadius="2"/>
                        <Border x:Name="Face"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SubtleBgBrush}"/>
                            <Setter TargetName="Face" Property="Margin" Value="-1,-1,1,1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="2,2,-2,-2"/>
                            <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Preset Pill Button ───────────────────────────────────────────────── -->
    <Style x:Key="SwissPresetButton" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Background" Value="{StaticResource SubtleBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bdr"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="{StaticResource AccentYellowBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="#FFE833"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Input TextBox ────────────────────────────────────────────────────── -->
    <Style x:Key="SwissTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bdr"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="#FFFFFC"/>
                            <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                            <Setter TargetName="bdr" Property="Effect" Value="{StaticResource HardShadow2px}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── CheckBox ─────────────────────────────────────────────────────────── -->
    <Style x:Key="SwissCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
